# Copy to .env (Bun auto-loads .env from the project root).

# --- LLM provider selection ---
# Which provider/model the agent talks to. Provider implementations live in
# packages/agent/src/providers/. All seven providers are implemented; they
# vary in capabilities (vision/thinking/server tools) and rate-limit defaults.
#   LLM_PROVIDER one of: anthropic | openai | kimi | google | mistral | deepseek | xai | qwen
#   LLM_MODEL    provider-specific model id (falls back to a provider default)
LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6
# LLM_MODEL=gpt-4o            # if LLM_PROVIDER=openai
# LLM_MODEL=kimi-k2-0905-preview  # if LLM_PROVIDER=kimi
# LLM_MODEL=kimi-k3               # Kimi K3 (always reasons, ~3x the price of k2.6)

#   VISION_PROVIDER / VISION_MODEL
#     Optional override for image processing (chat photo captions, food photo
#     recognition, receipt scanning). When unset, vision reuses the chat
#     provider if it supports images, else falls back to Anthropic when an
#     ANTHROPIC_API_KEY is present. Set these to pin a specific vision model,
#     e.g. when your chat model (kimi-k2.6, deepseek-chat) can't see images.
# VISION_PROVIDER=anthropic
# VISION_MODEL=claude-sonnet-4-6

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional limit overrides (use if your org tier differs from packaged defaults).
# ANTHROPIC_RPM=1000
# ANTHROPIC_ITPM=450000
# ANTHROPIC_OTPM=90000

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_RPM=500
# OPENAI_TPM=30000

# --- Kimi (Moonshot AI) ---
# Falls back to MOONSHOT_API_KEY if KIMI_API_KEY isn't set.
# KIMI_API_KEY=sk-...
# KIMI_RPM=200
# KIMI_TPM=2000000

# --- Other providers ---
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# QWEN_API_KEY=        # falls back to DASHSCOPE_API_KEY
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  # China-region keys; default is the intl endpoint

# --- Database ---
# Postgres connection string. Use Neon, Supabase, Railway, Fly, or local Docker.
# Local dev: docker run -d -e POSTGRES_PASSWORD=dev -p 5433:5432 postgres:16
# DATABASE_URL=postgres://postgres:dev@localhost:5433/fitness
# Note: docker-compose maps the host port via POSTGRES_PORT (default 5433) to
# avoid clashing with other local Postgres instances.
DATABASE_URL=

# --- Food reference search ---
# Two backends, switched by FOODREF_LIVE:
#   unset/false (dev)  → self-hosted Meilisearch index (below), and the
#                        Qdrant-backed search_knowledge tool is available.
#   true       (prod)  → live public APIs: OpenFoodFacts (branded/barcode) +
#                        USDA FoodData Central (generics, needs FDC_API_KEY).
#                        Meilisearch + Qdrant are ignored; search_knowledge is
#                        auto-hidden since the vector DB isn't deployed to prod.
# FOODREF_LIVE=false
# Free USDA FoodData Central key (https://fdc.nal.usda.gov/api-key-signup.html).
# Optional: enables USDA generics on the live path. If blank, lookups use
# OpenFoodFacts only (keyless); USDA is skipped with one warning.
# FDC_API_KEY=

# --- Food reference index (Meilisearch, dev) ---
# Self-hosted food data (OpenFoodFacts subset + USDA) replaces the live
# OpenFoodFacts API. docker-compose starts a `meilisearch` service and the
# app connects to it internally. Load the data with:
#   docker compose run --rm foodref-import   (after placing dumps under ./data)
# MEILI_URL defaults to http://localhost:7700 outside compose.
MEILI_URL=http://localhost:7700
# Master key — also used to authenticate the importer. Meilisearch requires
# at least 16 bytes when MEILI_ENV=production (compose default). Use a strong
# random value in prod (e.g. openssl rand -base64 24).
MEILI_MASTER_KEY=dev_master_key_change_me
# Optional: host port for the meilisearch container (default 7700).
# MEILI_PORT=7700
# Optional: host port for the meilisearch-ui web UI (default 24900). Start it
# manually with: docker compose up -d meilisearch-ui, then open the UI and
# connect to http://localhost:7700 using MEILI_MASTER_KEY.
# MEILI_UI_PORT=24900
# Importer input paths (defaults assume ./data mounted at /data in compose):
# OFF_DUMP_PATH=./data/openfoodfacts-products.jsonl.gz
# USDA_DIR=./data/usda

# --- Vector knowledge base (Qdrant) ---
# Self-hosted vector DB for semantic retrieval (RAG). docker-compose starts a
# `qdrant` service; the app + seeder connect to it. Seed the demo corpus:
#   docker compose run --rm qdrant-seed
# Browse it at http://localhost:6333/dashboard (Qdrant's built-in UI).
# QDRANT_URL defaults to http://localhost:6333 outside compose.
QDRANT_URL=http://localhost:6333
# Optional API key (leave empty for an unauthenticated local Qdrant).
QDRANT_API_KEY=
# Optional host ports for the qdrant container (defaults 6333 REST / 6334 gRPC).
# QDRANT_PORT=6333
# QDRANT_GRPC_PORT=6334
# Embedder — provider-agnostic. Any OpenAI-compatible embeddings API works
# (OpenAI, SiliconFlow, DeepInfra, or a self-hosted vLLM/TEI/Infinity). Swapping
# provider OR model later is env-only; then `reindex` to re-embed. Selector:
#   remote (default when a URL/key is set) | local (dependency-free fallback)
QDRANT_EMBEDDER=remote
# Hosted Qwen3-8B via SiliconFlow (OpenAI-compatible /embeddings + /rerank).
EMBEDDER_URL=https://api.siliconflow.com/v1
EMBEDDER_API_KEY=                            # provider key for embeddings (secret)
RERANKER_URL=https://api.siliconflow.com/v1
RERANKER_API_KEY=                            # provider key for reranking (secret)
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
RERANKER_MODEL=Qwen/Qwen3-Reranker-8B
EMBEDDING_DIM=4096                           # 4096 (8B) | 2560 (4B) | 1024 (0.6B) | 1536 (OpenAI 3-*)
EMBED_REVISION=v1                            # bump to invalidate the embedding cache
RAG_RERANK=true                              # set false to skip reranking (faster)
# EMBEDDING_INSTRUCT=true                     # force query-instruction prefix (auto-on for Qwen)
# Set KNOWLEDGE_DISABLED=true to hide the agent's search_knowledge tool.

# PubMed ingest (E-utilities) — only used by the ingest script.
# NCBI_API_KEY=                              # raises the rate limit to 10 req/s
# NCBI_EMAIL=you@example.com                 # required etiquette for bulk fetch

# --- Reference file storage (MinIO / S3) ---
# Stores the original guideline PDFs / documents behind the knowledge base.
# docker-compose starts a `minio` service; files are served via the app's
# /files/<key> route (citations link there).
S3_ENDPOINT=localhost                        # compose-internal host is `minio`
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin                     # change in prod (secret)
S3_SECRET_KEY=minioadmin                     # change in prod (secret)
S3_BUCKET=fa-knowledge
# S3_PUBLIC_BASE_URL=                         # set if MinIO/CDN is browser-reachable
# MINIO_PORT=9000                             # host port for the S3 API
# MINIO_CONSOLE_PORT=9001                     # host port for the MinIO web console

# --- Better Auth ---
# Generate a 32+ byte random string. Bash: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Public URL of this server (used in email links, cookie scope).
BETTER_AUTH_URL=http://localhost:3000

# --- Google sign-in (optional) ---
# OAuth client from Google Cloud Console → APIs & Services → Credentials
# (type "Web application"). Leave blank to hide the "Continue with Google"
# button. Authorized redirect URIs — one per domain users sign in from:
#   http://localhost:5173/api/auth/callback/google      (dev, via Vite)
#   https://app.example.com/api/auth/callback/google    (your public host)
# and the matching Authorized JavaScript origin, e.g. https://app.example.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Email (Resend) ---
# If empty, email contents are logged to stdout in dev. Set in production.
RESEND_API_KEY=
EMAIL_FROM="Jim-Bro <noreply@yourdomain.com>"

# --- Frontend / CORS ---
# Comma-separated origin allowlist. Required for browser frontends.
FRONTEND_ORIGIN=http://localhost:5173

# --- Optional ---
# PORT=3000
# --- Logging (@fa/logger) ---
# LOG_LEVEL       debug|info|warn|error|silent   (default: info; debug when NODE_ENV != production)
# LOG_FORMAT      pretty|json                    (default: pretty locally, json in production)
# LOG_TRANSPORTS  comma-separated sinks. Today: "console". Plug in "sentry"/"loki"
#                 by implementing Transport and registering in packages/logger/src/config.ts.
# LOG_COLOR       1|0   force-enable/disable ANSI colours (default: auto from TTY)
# LOG_HTTP        1|0   toggle the per-request "request" log line (default: 1)
# LOG_LEVEL=debug
# LOG_FORMAT=pretty
# LOG_TRANSPORTS=console
# LOG_HTTP=1

# Server extensions: comma-separated module specifiers loaded at startup, each
# default-exporting a ServerExtension (apps/server/src/extensions.ts). Use it to
# plug in add-on packages (plans, payments, …) without editing core files.
# SERVER_EXTENSIONS=
